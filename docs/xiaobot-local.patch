+		return &openai.ChatCompletionResponse{Choices: []openai.Choice{{Message: openai.ChatCompletionMessage{Content: "二"}}}}, nil
+	})}
+	if a, err := e.Answer(context.Background(), "一加一等于几"); err != nil || len(a.Searches) != 0 {
+		t.Fatal(a, err)
+	}
+}
