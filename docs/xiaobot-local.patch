new file mode 100644
index 0000000..6137ae8
--- /dev/null
+++ b/cmd/lx04-agent/main.go
@@ -0,0 +1,237 @@
+// Modified or added for XiaoSeek LX04, 2026-10-24. See NOTICE.
+// SPDX-License-Identifier: Apache-2.0
+// Standalone LX04 agent: native ASR, automatic routing, DeepSeek, native TTS.
+package main
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"log"
+	"os"
+	"os/exec"
+	"os/signal"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	"xiaobot"
+	"xiaobot/deepseekweb"
+	"xiaobot/devicevoice"
+	"xiaobot/jarvis/openai"
+	"xiaobot/runtimeenv"
+	"xiaobot/voiceanswer"
+)
+
+type agent struct {
+	mu         sync.Mutex
+	gate       *devicevoice.AudioGate
+	box        *xiaobot.XiaoMi
+	client     *openai.Client
+	answerer   *voiceanswer.Engine
+	config     *xiaobot.Config
+	generation int
+	cancel     context.CancelFunc
+	pending    string
+	lastQuery  string
+	lastAt     time.Time
+}
+
+func (a *agent) restore() {
+	if err := a.gate.Restore(); err != nil {
+		log.Print("audio recovery failed; recovery file retained")
+	}
+}
+func (a *agent) onSpeak(text string) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.pending != "" && strings.TrimSpace(text) == a.pending {
+		a.pending = ""
+		a.restore()
+		log.Print("DeepSeek speech received locally; audio restored")
+	}
+}
+func (a *agent) onQuery(query string) {
+	q := strings.TrimSpace(query)
+	if q == "" {
+		return
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if q == a.lastQuery && time.Since(a.lastAt) < 2*time.Second {
+		return
+	}
+	a.lastQuery = q
+	a.lastAt = time.Now()
+	a.generation++
+	generation := a.generation
+	if a.cancel != nil {
+		a.cancel()
+	}
+	a.pending = ""
+	if devicevoice.NativeRequest(q) {
+		a.restore()
+		log.Print("route=native")
+		return
+	}
+	if err := a.gate.Mute(); err != nil {
+		a.restore()
+		log.Print("audio gate unavailable; native answer retained")
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 25*time.Second)
+	a.cancel = cancel
+	log.Printf("route=deepseek query=%s", q)
+	go a.answer(ctx, generation, q)
+	// Bounded watchdog restores audio even if the network or native TTS stalls.
+	go func() {
+		<-ctx.Done()
+		a.mu.Lock()
+		defer a.mu.Unlock()
+		if a.generation == generation {
+			a.pending = ""
+			a.restore()
+		}
+	}()
+}
+func (a *agent) answer(ctx context.Context, generation int, query string) {
+	started := time.Now()
+	response, err := a.answerer.Answer(ctx, query)
+	text := devicevoice.SpeechText(response.Text)
+	if len(response.Searches) > 0 {
+		data, _ := json.MarshalIndent(struct {
+			Question string                     `json:"question"`
+			At       time.Time                  `json:"at"`
+			Searches []voiceanswer.SearchRecord `json:"searches"`
+		}{query, time.Now(), response.Searches}, "", "  ")
+		os.WriteFile(filepath.Join(filepath.Dir(a.gate.Path), "last-search.json"), data, 0600)
+		log.Printf("web search completed: %d search calls", len(response.Searches))
+	}
+	if err != nil {
+		text = "网络请求暂时没有成功，请稍后再试。"
+		if errors.Is(err, deepseekweb.ErrSearch) {
+			text = "这次联网搜索没有成功，暂时无法核实最新信息，请稍后再试。"
+		}
+		log.Print("answer request failed; preparing bounded spoken feedback")
+	}
+	if text == "" {
+		a.mu.Lock()
+		defer a.mu.Unlock()
+		if a.generation == generation {
+			a.restore()
+		}
+		return
+	}
+	a.mu.Lock()
+	if a.generation != generation || ctx.Err() != nil {
+		a.mu.Unlock()
+		return
+	}
+	a.pending = text
+	a.mu.Unlock()
+	log.Printf("DeepSeek answer ready in %s: %s", time.Since(started).Round(time.Millisecond), text)
+	err = a.box.MiTTS(text)
+	a.mu.Lock()
+	if a.generation != generation {
+		a.mu.Unlock()
+		return
+	}
+	if err != nil {
+		a.pending = ""
+		a.restore()
+		log.Print("native TTS request failed; audio restored")
+		a.mu.Unlock()
+		return
+	}
+	a.mu.Unlock()
+	// Fallback for a native build that does not log its Speak instruction.
+	timer := time.NewTimer(time.Second)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return
+	case <-timer.C:
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.generation == generation && a.pending != "" {
+		a.pending = ""
+		a.restore()
+		log.Print("TTS accepted; audio restored by fallback")
+	}
+}
+
+func main() {
+	configPath := flag.String("config", "/data/adb/lx04-deepseek/config.json", "private config")
+	restoreOnly := flag.Bool("restore-audio", false, "restore saved playback state and exit")
+	flag.Parse()
+	xiaobot.FixedZone()
+	gate := &devicevoice.AudioGate{Path: filepath.Join(filepath.Dir(*configPath), ".audio-restore.json")}
+	if err := gate.Restore(); err != nil {
+		log.Fatal("could not restore saved audio state")
+	}
+	if *restoreOnly {
+		return
+	}
+	if !devicevoice.SupportedAudioService() {
+		log.Fatal("unsupported audio service; no audio changes made")
+	}
+	if runtimeenv.ConfigureDNSFromEnv() != nil {
+		log.Fatal("invalid DNS configuration")
+	}
+	cfg, err := xiaobot.NewConfigFromFile(*configPath)
+	if err != nil || cfg == nil || cfg.NeedSetup() || cfg.Hardware != "LX04" {
+		log.Fatal("speaker configuration incomplete")
+	}
+	box := xiaobot.NewXiaoMi(cfg)
+	if box.InitMiBox() != nil {
+		log.Fatal("Xiaomi session initialization failed")
+	}
+	client := openai.NewClient(cfg.OpenAIKey, cfg.OpenAIBackend, "")
+	client.GPTOptions = cfg.GPTOptions
+	answerer := &voiceanswer.Engine{Chat: client, Search: deepseekweb.NewClient(cfg.OpenAIKey), Model: cfg.Bot, Prompt: cfg.Prompt}
+	a := &agent{gate: gate, box: box, client: client, config: cfg, answerer: answerer}
+	ctx, cancel := signal.NotifyContext(context.Background(), syscall.SIGTERM, syscall.SIGINT)
+	defer cancel()
+	go func() {
+		<-ctx.Done()
+		a.mu.Lock()
+		if a.cancel != nil {
+			a.cancel()
+		}
+		a.restore()
+		a.mu.Unlock()
+	}()
+	defer a.restore()
+	cmd := exec.CommandContext(ctx, "/system/bin/logcat", "-v", "raw", "-T", time.Now().Format("01-02 15:04:05.000"), "MICO.cap:I", "MICO.speech:I", "*:S")
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		log.Fatal("local speech pipe failed")
+	}
+	cmd.Stderr = os.Stderr
+	if cmd.Start() != nil {
+		log.Fatal("could not start local speech listener")
+	}
+	log.Print("ready: native ASR, automatic routing, on-device DeepSeek client")
+	scanner := bufio.NewScanner(stdout)
+	scanner.Buffer(make([]byte, 64*1024), 1024*1024)
+	for scanner.Scan() {
+		e := devicevoice.ParseEvent(scanner.Text())
+		switch e.Kind {
+		case "query":
+			a.onQuery(e.Text)
+		case "speak":
+			a.onSpeak(e.Text)
+		}
+	}
+	if scanner.Err() != nil {
+		fmt.Fprintln(os.Stderr, "local speech listener read failed")
+	}
+	cancel()
+	cmd.Wait()
+}
diff --git a/cmd/lx04-bootstrap/main.go b/cmd/lx04-bootstrap/main.go
new file mode 100644
index 0000000..6349784
--- /dev/null
+++ b/cmd/lx04-bootstrap/main.go
@@ -0,0 +1,160 @@
+// Modified or added for XiaoSeek LX04, 2026-10-24. See NOTICE.
+// SPDX-License-Identifier: Apache-2.0
+// Authenticate on the speaker, select only the user's known LX04, and test TTS.
+package main
+
+import (
+	"encoding/json"
+	"errors"
+	"flag"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"xiaobot"
+	"xiaobot/miservice"
+	"xiaobot/runtimeenv"
+)
+
+func main() {
+	path := flag.String("config", "", "private config file")
+	devicePath := flag.String("device-file", "", "private JSON with serial_number and/or mac; exact match required")
+	speak := flag.Bool("speak", false, "send a bounded speech test")
+	resume := flag.Bool("resume", false, "reuse the private verification session")
+	history := flag.Bool("check-history", false, "check conversation access without logging conversations")
+	flag.Parse()
+	if *path == "" || *devicePath == "" {
+		fmt.Fprintln(os.Stderr, "-config and -device-file are required; refusing automatic device selection")
+		os.Exit(2)
+	}
+	var selector deviceSelector
+	data, err := os.ReadFile(*devicePath)
+	if err != nil || json.Unmarshal(data, &selector) != nil || !selector.valid() {
+		fmt.Fprintln(os.Stderr, "private device selector missing or invalid")
+		os.Exit(2)
+	}
+	dir := filepath.Dir(*path)
+	status := map[string]any{}
+	finish := func(state string, code int) {
+		status["status"] = state
+		data, _ := json.MarshalIndent(status, "", "  ")
+		os.WriteFile(filepath.Join(dir, "bootstrap-status.json"), append(data, '\n'), 0600)
+		os.Exit(code)
+	}
+	if runtimeenv.ConfigureDNSFromEnv() != nil {
+		finish("dns_config_invalid", 1)
+	}
+	config, err := xiaobot.NewConfigFromFile(*path)
+	if err != nil || config.Account == "" || config.Password == "" {
+		finish("credentials_missing", 1)
+	}
+	config.TokenPath = filepath.Join(dir, ".mi.token")
+	account := miservice.NewAccount(config.Account, config.Password, miservice.NewTokenStore(config.TokenPath))
+	if *resume {
+		if err := account.RestoreVerificationSession(filepath.Join(dir, "otp-session.json")); err != nil {
+			status["error"] = err.Error()
+			finish("verification_resume_failed", 1)
+		}
+	}
+	account.SetOTPProvider(func(method string) (string, error) {
+		status["status"] = "verification_required"
+		status["verification_method"] = method
+		data, _ := json.MarshalIndent(status, "", "  ")
+		os.WriteFile(filepath.Join(dir, "bootstrap-status.json"), data, 0600)
+		codePath := filepath.Join(dir, "otp.txt")
+		for deadline := time.Now().Add(10 * time.Minute); time.Now().Before(deadline); time.Sleep(time.Second) {
+			data, err := os.ReadFile(codePath)
+			if err == nil && strings.TrimSpace(string(data)) != "" {
+				os.Remove(codePath)
+				return strings.TrimSpace(string(data)), nil
+			}
+		}
+		return "", fmt.Errorf("verification input timed out")
+	})
+	service := miservice.NewAIService(account)
+	devices, err := service.DeviceList(0)
+	if err != nil {
+		// Library errors have been sanitized; never serialize raw API responses.
+		status["error"] = err.Error()
+		var login *miservice.LoginError
+		if errors.As(err, &login) {
+			status["login_code"] = login.Code
+			if login.VerificationURL != "" || login.CaptchaURL != "" {
+				data, _ := json.Marshal(login)
+				os.WriteFile(filepath.Join(dir, "login-verification.json"), data, 0600)
+				status["verification_file_created"] = true
+			}
+		}
+		finish("xiaomi_login_or_device_list_failed", 1)
+	}
+	matches := []miservice.DeviceData{}
+	for _, d := range devices {
+		if selector.matches(d) {
+			matches = append(matches, d)
+		}
+	}
+	status["exact_matches"] = len(matches)
+	if len(matches) != 1 {
+		finish("speaker_match_failed", 1)
+	}
+	if matches[0].MiotDID == "" {
+		finish("matched_speaker_has_no_miot_did", 1)
+	}
+	config.MiDID = matches[0].MiotDID
+	data, err = json.MarshalIndent(config, "", "  ")
+	if err != nil || os.WriteFile(*path, append(data, '\n'), 0600) != nil {
+		finish("config_save_failed", 1)
+	}
+	os.Chmod(*path, 0600)
+	status["did_configured"] = true
+	if *history {
+		u := strings.ReplaceAll(xiaobot.LatestAskApi, "{hardware}", "LX04")
+		u = strings.ReplaceAll(u, "{timestamp}", fmt.Sprint(time.Now().UnixMilli()))
+		var result struct {
+			Code int    `json:"code"`
+			Data string `json:"data"`
+		}
+		err := account.Request("micoapi", u, nil, func(_ *miservice.Tokens, cookie map[string]string) url.Values {
+			cookie["deviceId"] = matches[0].DeviceID
+			return nil
+		}, nil, true, &result)
+		if err != nil {
+			status["error"] = err.Error()
+			finish("conversation_access_failed", 1)
+		}
+		status["conversation_access"] = true
+	}
+	if *speak {
+		box := xiaobot.NewXiaoMi(config)
+		if box.InitMiBox() != nil {
+			finish("speaker_initialization_failed", 1)
+		}
+		if box.MiTTS("DeepSeek 接入测试，语音播报连接成功。") != nil {
+			finish("speech_test_failed", 1)
+		}
+		status["speech_test_sent"] = true
+	}
+	finish("ready", 0)
+}
+
+type deviceSelector struct {
+	SerialNumber string `json:"serial_number"`
+	Mac          string `json:"mac"`
+}
+
+func normalize(v string) string {
+	return strings.NewReplacer(":", "", "-", "", "/", "", " ", "").Replace(strings.ToUpper(v))
+}
+
+func (s deviceSelector) valid() bool {
+	return normalize(s.SerialNumber) != "" || normalize(s.Mac) != ""
+}
+
+func (s deviceSelector) matches(d miservice.DeviceData) bool {
+	return s.valid() && d.Hardware == "LX04" &&
+		(normalize(s.SerialNumber) == "" || normalize(s.SerialNumber) == normalize(d.SerialNumber)) &&
+		(normalize(s.Mac) == "" || normalize(s.Mac) == normalize(d.Mac))
+}
diff --git a/cmd/lx04-bootstrap/main_test.go b/cmd/lx04-bootstrap/main_test.go
new file mode 100644
index 0000000..1fdfe3a
--- /dev/null
+++ b/cmd/lx04-bootstrap/main_test.go
@@ -0,0 +1,30 @@
+// Modified or added for XiaoSeek LX04, 2026-10-24. See NOTICE.
+// SPDX-License-Identifier: Apache-2.0
+package main
+
+import (
+	"testing"
+	"xiaobot/miservice"
+)
+
+func TestDeviceSelectorRequiresAllSpecifiedIdentifiers(t *testing.T) {
+	d := miservice.DeviceData{Hardware: "LX04", SerialNumber: "EXAMPLE/123", Mac: "02:00:00:00:00:01"}
+	for _, tc := range []struct {
+		selector deviceSelector
+		want     bool
+	}{
+		{deviceSelector{}, false},
+		{deviceSelector{SerialNumber: "example123"}, true},
+		{deviceSelector{Mac: "020000000001"}, true},
+		{deviceSelector{SerialNumber: "wrong", Mac: d.Mac}, false},
+		{deviceSelector{SerialNumber: d.SerialNumber, Mac: "02:00:00:00:00:02"}, false},
+	} {
+		if got := tc.selector.matches(d); got != tc.want {
+			t.Fatalf("selector match = %v, want %v", got, tc.want)
+		}
+	}
+	d.Hardware = "OTHER"
+	if (deviceSelector{Mac: d.Mac}).matches(d) {
+		t.Fatal("wrong hardware accepted")
+	}
+}
